# Copy to .env.local for local overrides. Do not commit real keys.
# The anon key in src/lib/supabase.ts is public; the service role key must
# never ship to the client (use Supabase Edge Functions / server env only).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Supabase Edge Function secrets, not Vite):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
